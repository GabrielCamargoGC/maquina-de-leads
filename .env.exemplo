# Copie para .env e preencha. O .env NAO vai para o Git (ver .gitignore).

# Token do tunel Cloudflare. Painel > Zero Trust > Networks > Tunnels > Create.
# E um texto longo comecando com eyJ...
LEADS_TUNEL_TOKEN=

# --- opcionais: os padroes ja servem para o desktop de 8 GB ---

# Porta local do site. O cloudflared aponta para ela.
# LEADS_PORTA=8080

# Teto de memoria do DuckDB.
#   o site divide a maquina com 15 pessoas -> 2 GB
#   a importacao roda as 03:00 sozinha      -> 5 GB
# LEADS_DUCKDB_MEMORIA=2GB
# LEADS_DUCKDB_MEMORIA_IMPORT=5GB

# Buscas simultaneas e planilhas geradas ao mesmo tempo.
# LEADS_WEB_THREADS=8
# LEADS_EXPORTS_SIMULTANEOS=2

# Onde ficam os dados. So mude se for usar outro disco.
# LEADS_DADOS=C:\leads\dados
# LEADS_DOWNLOADS=C:\leads\downloads
